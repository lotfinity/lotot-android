<resources>
    <!-- LotoT styling for all remaining native AndrOBD screens. -->
    <style name="AppTheme" parent="Theme.Material3.Dark">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/lotot_background</item>
        <item name="android:colorAccent">@color/lotot_accent</item>
        <item name="android:colorControlActivated">@color/lotot_accent</item>
        <item name="android:colorControlHighlight">#33CAFF00</item>
        <item name="android:textColorPrimary">@color/lotot_text</item>
        <item name="android:textColorSecondary">@color/lotot_muted</item>
        <item name="android:navigationBarColor">@color/lotot_background</item>
        <item name="android:statusBarColor">@color/lotot_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:actionMenuTextColor">@color/lotot_accent</item>
        <item name="android:panelColorBackground">@color/lotot_surface_raised</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background</item>
        <item name="android:listDivider">@color/lotot_divider</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="AppTheme.Dark" parent="AppTheme" />

    <style name="AppTheme.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/lotot_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">@color/lotot_background</item>
        <item name="android:statusBarColor">@color/lotot_background</item>
    </style>

    <style name="AppTheme.Light" parent="Theme.Material3.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/lotot_light_background</item>
        <item name="android:colorAccent">@color/lotot_light_accent</item>
        <item name="android:colorControlActivated">@color/lotot_light_accent</item>
        <item name="android:colorControlHighlight">#226F9200</item>
        <item name="android:textColorPrimary">@color/lotot_light_text</item>
        <item name="android:textColorSecondary">@color/lotot_light_muted</item>
        <item name="android:navigationBarColor">@color/lotot_light_background</item>
        <item name="android:statusBarColor">@color/lotot_light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:actionMenuTextColor">@color/lotot_light_accent</item>
        <item name="android:panelColorBackground">@color/lotot_light_surface_raised</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background</item>
        <item name="android:listDivider">@color/lotot_light_divider</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
